# Copy to .env and fill in (docker compose and npm run dev read it). On Railway, set these in the service's
# Variables tab instead: BASE_URL and DATA_DIR are then found by themselves.

# Public https address of this server, without a path. Not needed on Railway or Render.
BASE_URL=https://whatsapp.example.com

# Password for the admin page (logging in to Telegram) and for approving Claude. At least 12 characters.
ADMIN_PASSWORD=

# 32-byte key that encrypts the Telegram session. Generate both secrets with "npm run generate-secrets".
# Keep a copy: without it the session is lost and Telegram must be logged in again.
TOKEN_ENCRYPTION_KEY=

# Host names of your other connectors (G-Spot Assistant, WhatsApp connector) that Telegram files may be sent to.
PEER_UPLOAD_HOSTS=connector-production.up.railway.app,whatsapp-production.up.railway.app

# Optional: Telegram API keys from my.telegram.org → API development tools (else entered on the admin page).
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# Bots Claude may message and press buttons in (usernames, comma-separated). Empty: none.
# TELEGRAM_BOT_ALLOWLIST=

# Optional. Defaults shown.
# DEFAULT_TIMEZONE=UTC                # IANA zone the times are shown in, e.g. Europe/Paris
# PORT=8080
# DATA_DIR=/data
# MCP_PATH=/mcp
# SERVER_NAME=Telegram Connector
# LOG_LEVEL=info                      # debug | info | warn | error
# TRUST_PROXY=1
# DCR_ENABLED=true
# CIMD_ALLOWED_HOSTS=claude.ai
# EXTRA_REDIRECT_URIS=
# ANTHROPIC_IP_LOCK=false
# TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Optional: voice messages (telegram_send_voice) with ElevenLabs. The tool appears only when both are set.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2   # or eleven_v3
# ELEVENLABS_STYLE_TAGS=                       # eleven_v3 only: default style when a message asks for none
# VOICE_MAX_CHARS=600

# Voice notes as text (uses ELEVENLABS_API_KEY) and text in photos (Tesseract, on this server).
# TRANSCRIBE=off
# TRANSCRIBE_MAX_SECONDS=600
# OCR=off
# OCR_LANGUAGES=eng+fra+rus
